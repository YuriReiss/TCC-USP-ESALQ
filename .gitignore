# ==========================================
# Ambientes Virtuais (Virtual Environments)
# ==========================================
venv/
.venv/
env/
ENV/
Chalice/.chalice/
.python-version

# ==========================================
# Arquivos de Execução e Cache do Python
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
node_modules/


# Bloqueio genérico para qualquer arquivo de dados esquecido na raiz ou notebooks
*.xlsx
*.parquet
*.json
*.sqlite
*.db

# O bloqueio de *.json acima apanhava também o manifesto do Node, sem o qual ninguém
# consegue reinstalar as dependências e reproduzir o backtest. Reprodutibilidade é
# requisito do trabalho, então estes dois voltam.
!package.json
!package-lock.json

# ==========================================
# Logs de execução (ruído, não resultado)
# ==========================================
*.log

# ==========================================
# Caches de Bibliotecas (yfinance, etc.)
# ==========================================
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ==========================================
# Jupyter Notebooks (Checkpoints temporários)
# ==========================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*
*.pydevproject

# ==========================================
# Segurança e Configurações Locais
# ==========================================
.env
.env.local
.env.*
.secrets
env.*

# ==========================================
# Editores de Código e IDEs
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp